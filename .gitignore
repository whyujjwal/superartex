# backend
/data/
*.db
*.db-wal
*.db-shm
config.json
scheduler_state.json
__pycache__/
*.pyc
*.pyo

# frontend
web/node_modules/
web/.next/
web/tsconfig.tsbuildinfo
web/next-env.d.ts
*.local

# development tools
.playwright-mcp/
.playwright-cli/
.idea/
.vscode/
*.swp
*.swo

# Keep the public handbook; ignore other local documentation artifacts.
/docs/*
!/docs/README.md
!/docs/getting-started.md
!/docs/usage.md
!/docs/configuration.md
!/docs/toolkit.md
!/docs/operations.md
!/docs/architecture.md
!/docs/security-model.md

# os
.DS_Store
Thumbs.db

# claude code local state
.claude/

# single-binary artifact with embedded frontend
/superartex
# intermediate artifacts left next to the executable by one-click update (staging file / backup / failed version / upgrade marker)
/superartex.new
/superartex.new.sha256
/superartex.old
/superartex.failed
/superartex.upgrade.json
/server/webui/dist/
/dist/

# JWT signing key (generated at runtime, stored in the project root, never committed)
/jwt.key
/secret.key
/keys/

# local environment generated by Docker deployment (contains passwords/keys, not committed)
.env

# event logs produced by scheduler runs/simulations (test artifacts, not committed)
*-events.csv

# bench benchmark related (local artifacts, not committed)
/bench/
/Dockerfile.bench
/Dockerfile.bench.v2

# scripts/backup.sh output (database dumps, data archives)
backups/

# posture probe raw output
posture-runs/

# benchmark runner output (one dir per run)
benchmark-results/
